---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Experience from '../components/Experience.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Research from '../components/Research.astro';
import AdditionalProjects from '../components/AdditionalProjects.astro';
import About from '../components/About.astro';
import WorkCardEnergy from '../components/WorkCardEnergy.astro';
import { projects } from '../lib/projects';
import { scopeProjectHtml } from '../lib/scope-html';
const entries = await Promise.all(projects.map(async project => ({ project: project.frontmatter, html: scopeProjectHtml(await project.compiledContent(), project.frontmatter.slug) })));
---
<BaseLayout>
  <main id="main" class="wrap portfolio-main">
    <WorkCardEnergy />
    <Hero /><Experience />
    <section class="section" id="projects">
      <SectionHeading number="02" title="Projects"><span class="section-caption"><span class="pointer-label">Selected work · Click to explore</span><span class="touch-label">Selected work · Tap for details</span></span></SectionHeading>
      <div class="project-list">{entries.map((entry, index) => <ProjectCard project={entry.project} html={entry.html} index={index} />)}</div>
    </section>
    <Research /><AdditionalProjects /><About />
  </main>
</BaseLayout>

---
import site from '../data/site.json';
---
<section class="hero">
  <div>
    <div class="availability"><span class="dot"></span>{site.status}</div>
    <h1>{site.name}</h1><p class="intro">{site.intro}</p>
    <div class="actions"><a class="btn" href="#experience">View experience <span>↘</span></a><a class="textlink" href={site.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a></div>
  </div>
  <div class="hero-art"><svg viewBox="0 0 300 270" role="img" aria-label="Software, systems, and applied AI connected around a shared engineering foundation"><g fill="none" stroke="#a3b79c" stroke-width="1"><circle cx="150" cy="127" r="91" stroke-dasharray="3 6"/><path d="M150 50V102M72 167l58-29m97 29-58-29"/></g><rect x="116" y="94" width="68" height="68" rx="14" fill="#254d3f"/><text x="150" y="135" text-anchor="middle" fill="#f2f5ec" font-family="monospace" font-size="25">&lt;/&gt;</text><g fill="#f6f7f3" stroke="#b6c6af"><rect x="93" y="20" width="114" height="37" rx="5"/><rect x="9" y="166" width="103" height="37" rx="5"/><rect x="189" y="166" width="103" height="37" rx="5"/></g><g fill="#41614f" font-size="12" text-anchor="middle" font-family="Arial"><text x="150" y="43">Software</text><text x="61" y="189">Systems</text><text x="241" y="189">Applied AI</text></g><circle cx="150" cy="242" r="3" fill="#678c66"/></svg><div class="caption">Software · Systems · Applied AI</div></div>
</section>

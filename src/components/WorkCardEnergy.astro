---
import ElectricCardEnergy from './ElectricCardEnergy.jsx';
---
<div class="data-particle-stream" data-particle-stream data-state="idle" aria-hidden="true">
  {Array.from({ length: 12 }, (_, i) => <i class:list={{ 'packet-glyph': i === 2 || i === 7 }}>{i === 2 ? '0' : i === 7 ? '1' : ''}</i>)}
</div>
<ElectricCardEnergy client:load />

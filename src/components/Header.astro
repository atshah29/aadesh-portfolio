---
import site from '../data/site.json';
---
<header class="site-header">
  <div class="wrap nav">
    <a class="brand" href="/" aria-label={`AS. ${site.name} home`}><span class="brand-mark" aria-hidden="true">AS<span class="brand-dot">.</span></span><span class="brand-name">{site.name}</span></a>
    <button class="menu" aria-expanded="false" aria-controls="navigation"><span>Menu</span><span class="menu-lines" aria-hidden="true"><i></i><i></i></span></button>
    <nav id="navigation" class="links" aria-label="Main navigation">
      <a href="/#experience" data-nav-section="experience"><span>01</span> Experience</a>
      <a href="/#projects" data-nav-section="projects"><span>02</span> Projects</a>
      <a href="/#about" data-nav-section="about"><span>03</span> About</a>
      <a class="resume" href={site.resume} data-umami-event="resume_click" data-umami-event-destination={site.resume} target="_blank" rel="noopener noreferrer">Résumé <span aria-hidden="true">↗</span></a>
    </nav>
  </div>
  <noscript>
    <style is:inline>
      @media (max-width: 640px) {
        html { scroll-padding-top: 20px; }
        .site-header { position: static; }
        .nav { height: auto; min-height: 74px; flex-wrap: wrap; padding-block: 14px; gap: 12px; }
        .menu { display: none; }
        .links { display: flex; position: static; width: 100%; padding: 8px 0 0; background: none; border: 0; gap: 10px 18px; backdrop-filter: none; }
      }
    </style>
  </noscript>
</header>

---
import site from '../data/site.json';
import SectionHeading from './SectionHeading.astro';
const r = site.research;
---
<section class="section" id="research">
  <SectionHeading title="Research" />
  <article class="publication" data-reveal>
    <div class="publication-meta"><span class="eyebrow">{r.venue}</span><div class="paper-icon" aria-hidden="true"><span>BCough</span><i></i><i></i><i></i><span class="paper-year">2026</span></div></div>
    <div><div class="eyebrow">{r.role}</div><h3>{r.title}</h3><p>{r.description}</p>
      <div class="actions"><a class="textlink" href={r.url} target="_blank" rel="noopener noreferrer">Read the paper ↗</a><a class="textlink" href="#project-bcough" data-open-project="bcough">My contribution ↗</a></div>
    </div>
  </article>
</section>

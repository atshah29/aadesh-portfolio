---
import site from '../data/site.json';
---
<footer class="wrap contact" id="contact">
  <h2>Contact</h2>
  <div class="footer-row">
    <a class="textlink" href={`mailto:${site.email}`}>{site.email} ↗</a>
    <div class="footer-links"><a href={site.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a><a href={site.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn ↗</a><a href={site.resume} target="_blank" rel="noopener noreferrer">Résumé ↗</a></div>
  </div>
  <div class="footer-note">© {new Date().getFullYear()} {site.name}</div>
</footer>

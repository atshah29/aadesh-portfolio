---
import site from '../data/site.json';
---
<footer class="wrap contact" id="contact">
  <div class="contact-top" data-reveal><div><span class="eyebrow">06 / Get in touch</span><h2>Contact<span class="name-period">.</span></h2></div><a class="contact-email" href={`mailto:${site.email}`}>{site.email}<span aria-hidden="true">↗</span></a></div>
  <div class="footer-row">
    <span class="footer-note">© {new Date().getFullYear()} {site.name}</span>
    <div class="footer-links"><a href={site.github} data-umami-event="github_click" data-umami-event-destination={site.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a><a href={site.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn ↗</a><a href={site.resume} data-umami-event="resume_click" data-umami-event-destination={site.resume} target="_blank" rel="noopener noreferrer">Résumé ↗</a><a href="#main" class="back-top">Back to top ↑</a></div>
  </div>
</footer>

---
import { projects } from '../lib/projects';
import ProcessorPipeline from './ProcessorPipeline.astro';
import AudioPipeline from './AudioPipeline.astro';
const highlights = [
  { value: '2', unit: 'nd', caption: 'out of 60 teams', context: 'Graduate-level competition', result: '≈24% higher harmonic-mean IPC', left: 'SVP + VTAGE', right: '31.97 / 32 KB', labels: ['Predicted values let dependents execute early'] },
  { value: '≈70', unit: '%', caption: 'average runtime reduction', context: '22 custom benchmarks', result: 'LLM proposals, validated improvements', left: 'Apple M4 · Clang -O3', right: '22 custom benchmarks', labels: ['Analyze', 'Propose', 'Validate'] },
  { value: '15–16', unit: 'ms', caption: 'inference latency', context: 'MAX78000 on-device CNN', result: 'Published research · On-device cough detection', left: '8-bit CoughNet', right: '0.80 macro F1', labels: ['Audio', 'Mel spectrogram', 'CNN'] },
  { value: '1', unit: 'st', caption: 'attempt completion', context: 'Final examination course', result: 'Wireless control and autonomous line following', left: 'MSP430 + ESP32', right: 'Embedded C', labels: ['Sense', 'Correct', 'Follow'] },
];
---
<div class="hero-feature" data-featured-carousel role="region" aria-roledescription="carousel" aria-label="Featured projects">
  <div class="feature-top"><span class="eyebrow">Featured projects</span><span class="feature-index" data-feature-index>01 / 04</span></div>
  <div class="feature-slides">
    {projects.map(({ frontmatter: project }, index) => {
      const h = highlights[index];
      return <div class="feature-slide" data-feature-slide data-project={project.slug} data-title={project.cardTitle} role="group" aria-roledescription="slide" aria-label={`${index + 1} of ${projects.length}: ${project.cardTitle}`} hidden={index !== 0} inert={index !== 0}>
        <a class="feature-project-link" href={`#project-${project.slug}`} data-open-project={project.slug}>
          <div class="feature-rank"><strong class:list={{ 'compact-stat': index === 1 || index === 2 }}>{h.value}<span>{h.unit}</span></strong><span>{h.caption}<br />{h.context}</span></div>
          <div class="signal-diagram feature-illustration" aria-hidden="true">
            {index === 0 && <ProcessorPipeline />}
            {index === 1 && <svg viewBox="0 0 390 120" fill="none"><path class="signal-track" d="M0 60H390M304 65V100H85V75"/><path class="signal-pulse" data-optimizer-pulse d="M0 60H390"/>{[70, 170, 270].map((x, i) => <g data-optimizer-node><rect x={x - 20} y="38" width="44" height="44" rx="7"/><path d={i === 0 ? `M${x-8} 51H${x+10}M${x-8} 60H${x+5}M${x-8} 69H${x+10}` : i === 1 ? `M${x-7} 53L${x-13} 60L${x-7} 67M${x+9} 53L${x+15} 60L${x+9} 67` : `M${x-8} 60L${x-1} 67L${x+13} 53`}/></g>)}</svg>}
            {index === 2 && <AudioPipeline />}
            {index === 3 && <svg viewBox="0 0 390 120" fill="none"><path class="feature-route signal-track" d="M55 60C55 23 120 12 150 37S210 100 250 87S335 83 335 52S278 13 250 34S199 97 155 86S55 95 55 60Z"/><path class="route-guide" d="M55 60C55 23 120 12 150 37S210 100 250 87S335 83 335 52S278 13 250 34S199 97 155 86S55 95 55 60Z"/><circle class="vehicle-halo" data-vehicle-halo cx="55" cy="60" r="10"/><circle class="vehicle-point" data-vehicle-point cx="55" cy="60" r="4"/></svg>}
            <div class="signal-labels">{h.labels.map(label => <span>{label}</span>)}</div>
          </div>
          <div class="feature-bottom"><div><h2>{project.cardTitle}</h2><p>{h.result}</p></div><span class="circle-arrow" aria-hidden="true">↗</span></div>
          <div class="feature-footnote">{h.left}<span>{h.right}</span></div>
        </a>
      </div>;
    })}
  </div>
  <div class="feature-controls" data-feature-controls>
    <div class="feature-selectors" role="group" aria-label="Choose a featured project">{projects.map(({ frontmatter: p }, index) => <button type="button" data-feature-select={index} aria-label={`0${index + 1}: Show ${p.cardTitle}`} aria-pressed={index === 0 ? 'true' : 'false'}><span aria-hidden="true">0{index + 1}</span></button>)}</div>
    <button class="feature-playback" type="button" data-feature-playback aria-label="Pause automatic rotation" aria-pressed="false"><span class="playback-symbol" aria-hidden="true"></span><span data-playback-label>Pause</span></button>
  </div>
  <div class="feature-progress" data-feature-progress aria-hidden="true"></div>
  <span class="sr-only" data-feature-announcement aria-live="polite" aria-atomic="true"></span>
</div>
